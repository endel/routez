.{
    .access_log = false,
    .limits = .{ .max_connections_per_ip = 20 },
    .servers = .{.{
        .listen = .{
            .{ .address = "127.0.0.1", .port = 18080 },
            .{ .address = "127.0.0.1", .port = 18443, .tls = true, .quic = true },
        },
        .tls = .{ .cert = "CERTS/server.crt", .key = "CERTS/server.key" },
        .rewrite = .{.{ .regex = "^/srv-old/(.*)$", .replacement = "/m/$1" }},
        .locations = .{
            .{ .prefix = "/", .root = "WWW" },
            .{ .prefix = "/ping", .@"return" = .{ .body = "pong\n" } },
            .{ .prefix = "/status", .stub_status = true },
            .{ .prefix = "/gz/", .root = "WWW/..", .gzip = true, .add_headers = .{.{ .name = "x-served-by", .value = "routez" }} },
            .{ .prefix = "/api2/", .proxy_pass = "backend", .strip_prefix = true, .proxy_set_headers = .{
                .{ .name = "host", .value = "upstream.local" },
                .{ .name = "x-custom", .value = "v1" },
                .{ .name = "user-agent", .value = "" },
                .{ .name = "x-orig", .value = "$request_uri" },
            } },
            .{ .prefix = "/old/", .@"return" = .{ .status = 301, .location = "https://$host$request_uri" }, .add_headers = .{
                .{ .name = "x-vars", .value = "$scheme $uri $is_args$args $remote_addr" },
            } },
            .{ .prefix = "/spa/", .root = "WWW/..", .try_files = .{ "$uri", "$uri/", "/spa/index.html" } },
            .{ .prefix = "/sub/", .root = "WWW", .try_files = .{ "$uri", "=404" } },
            .{ .prefix = "/limited", .@"return" = .{ .body = "ok\n" }, .limit_req = .{ .rate = 1, .burst = 2 } },
            .{ .prefix = "/api/", .proxy_pass = "backend", .strip_prefix = true },
            .{ .prefix = "/tls/", .proxy_pass = "tls_backend", .strip_prefix = true },
            .{ .prefix = "/tls-insecure/", .proxy_pass = "tls_insecure", .strip_prefix = true },
            .{ .prefix = "/tls-wrong-ca/", .proxy_pass = "tls_wrong_ca", .strip_prefix = true },
            .{ .prefix = "/tls-wrong-name/", .proxy_pass = "tls_wrong_name", .strip_prefix = true },
            .{ .prefix = "/ws/", .proxy_pass = "127.0.0.1:19003" },
            .{ .prefix = "/slow/", .proxy_pass = "slow", .strip_prefix = true },
            .{ .prefix = "/slowup/", .proxy_pass = "127.0.0.1:19004", .strip_prefix = true },
            // Location precedence: exact, then a no_regex prefix, then regexes in order.
            .{ .prefix = "/m/", .@"return" = .{ .body = "prefix" } },
            .{ .regex = "^/m/(first|exact)", .@"return" = .{ .body = "first-regex" } },
            .{ .regex = "^/m/first", .@"return" = .{ .body = "second-regex" } },
            .{ .exact = "/m/exact", .@"return" = .{ .body = "exact" } },
            .{ .prefix = "/m/stop/", .no_regex = true, .@"return" = .{ .body = "stop" } },
            .{ .regex = "^/m/.*\\.png$", .@"return" = .{ .body = "png" } },
            .{ .regex = "\\.jpe?g$", .case_insensitive = true, .@"return" = .{ .body = "jpeg" } },
            .{ .regex = "^/m/user/(\\d+)/(.*)$", .proxy_pass = "backend/users/$2?id=$1" },
            .{ .regex = "^/m/go/(.*)$", .@"return" = .{ .status = 302, .location = "https://example.com/$1$is_args$args" }, .add_headers = .{.{ .name = "x-cap", .value = "$1" }} },
            .{ .prefix = "/m/pp/", .proxy_pass = "backend/v2/" },
            .{
                .prefix = "/rwp/",
                .proxy_pass = "backend",
                .proxy_set_headers = .{ .{ .name = "x-orig", .value = "$request_uri" }, .{ .name = "x-uri", .value = "$uri" } },
                .rewrite = .{
                    .{ .regex = "^/rwp/break/(.*)$", .replacement = "/new/$1", .flag = .@"break" },
                    .{ .regex = "^/rwp/noargs/(.*)$", .replacement = "/new/$1?", .flag = .@"break" },
                    .{ .regex = "^/rwp/addargs/(.*)$", .replacement = "/new/$1?a=1", .flag = .@"break" },
                    .{ .regex = "^/RWP/CI/(.*)$", .case_insensitive = true, .replacement = "/new/ci-$1", .flag = .@"break" },
                    .{ .regex = "^/rwp/last/(.*)$", .replacement = "/m/$1", .flag = .last },
                    .{ .regex = "^/rwp/redirect/(.*)$", .replacement = "/m/$1", .flag = .redirect },
                    .{ .regex = "^/rwp/permanent/(.*)$", .replacement = "https://example.com/$1", .flag = .permanent },
                    .{ .regex = "^/rwp/abs/(.*)$", .replacement = "$scheme://example.com/$1" },
                    .{ .regex = "^/rwp/loop/(.*)$", .replacement = "/rwp/loop/$1", .flag = .last },
                    .{ .regex = "^/rwp/chain/a$", .replacement = "/rwp/chain/b" },
                    .{ .regex = "^/rwp/chain/b$", .replacement = "/rwp/chain/c" },
                },
            },
            .{ .prefix = "/.well-known/webtransport", .webtransport_pass = "127.0.0.1:4450" },
            .{ .prefix = "/wt-slow", .webtransport_pass = "127.0.0.1:4451" },
            .{ .prefix = "/wt-credit", .webtransport_pass = "127.0.0.1:4452" },
        },
    }},
    .upstreams = .{
        .{
            .name = "backend",
            .servers = .{ "127.0.0.1:19001", "127.0.0.1:19002" },
            .health = .{ .path = "/healthz", .interval_ms = 500, .fall = 2, .rise = 2 },
        },
        .{ .name = "slow", .servers = .{"127.0.0.1:19004"}, .read_timeout_ms = 1000 },
        // HTTPS upstream; 127.0.0.1 is verified against the certificate's IP SAN.
        .{
            .name = "tls_backend",
            .servers = .{"127.0.0.1:19005"},
            .tls = true,
            .tls_ca = "CERTS/ca.crt",
            .health = .{ .path = "/healthz", .interval_ms = 500, .fall = 2, .rise = 2 },
        },
        .{ .name = "tls_insecure", .servers = .{"127.0.0.1:19005"}, .tls = true, .tls_server_name = "other.example" },
        // The leaf itself is no CA: its issuer is unknown.
        .{ .name = "tls_wrong_ca", .servers = .{"127.0.0.1:19005"}, .tls = true, .tls_ca = "CERTS/server.crt" },
        .{ .name = "tls_wrong_name", .servers = .{"127.0.0.1:19005"}, .tls = true, .tls_ca = "CERTS/ca.crt", .tls_server_name = "other.example" },
    },
}
