.{
    .access_log = false,
    .limits = .{ .max_connections_per_ip = 20 },
    .servers = .{.{
        .listen = .{
            .{ .address = "127.0.0.1", .port = 18080 },
            .{ .address = "127.0.0.1", .port = 18443, .tls = true, .quic = true },
        },
        .tls = .{ .cert = "CERTS/server.crt", .key = "CERTS/server.key" },
        .locations = .{
            .{ .prefix = "/", .root = "WWW" },
            .{ .prefix = "/ping", .@"return" = .{ .body = "pong\n" } },
            .{ .prefix = "/status", .stub_status = true },
            .{ .prefix = "/gz/", .root = "WWW/..", .gzip = true, .add_headers = .{.{ .name = "x-served-by", .value = "routez" }} },
            .{ .prefix = "/api2/", .proxy_pass = "backend", .strip_prefix = true, .proxy_set_headers = .{
                .{ .name = "host", .value = "upstream.local" },
                .{ .name = "x-custom", .value = "v1" },
                .{ .name = "user-agent", .value = "" },
            } },
            .{ .prefix = "/limited", .@"return" = .{ .body = "ok\n" }, .limit_req = .{ .rate = 1, .burst = 2 } },
            .{ .prefix = "/api/", .proxy_pass = "backend", .strip_prefix = true },
            .{ .prefix = "/ws/", .proxy_pass = "127.0.0.1:19003" },
            .{ .prefix = "/slow/", .proxy_pass = "slow", .strip_prefix = true },
            .{ .prefix = "/slowup/", .proxy_pass = "127.0.0.1:19004", .strip_prefix = true },
            .{ .prefix = "/.well-known/webtransport", .webtransport_pass = "127.0.0.1:4450" },
            .{ .prefix = "/wt-slow", .webtransport_pass = "127.0.0.1:4451" },
            .{ .prefix = "/wt-credit", .webtransport_pass = "127.0.0.1:4452" },
        },
    }},
    .upstreams = .{
        .{
            .name = "backend",
            .servers = .{ "127.0.0.1:19001", "127.0.0.1:19002" },
            .health = .{ .path = "/healthz", .interval_ms = 500, .fall = 2, .rise = 2 },
        },
        .{ .name = "slow", .servers = .{"127.0.0.1:19004"}, .read_timeout_ms = 1000 },
    },
}
