// routez for the HTTP/3 suite: h3 on UDP :19544, HTTP/1.1 over TLS on :19444.
.{
    .workers = WORKERS,
    .access_log = false,
    .qlog_dir = ROUTEZ_QLOG,
    .limits = .{ .max_connections = 100_000 },
    .servers = .{.{
        .listen = .{
            // QUIC always has TLS; `tls` is the flag for the TCP listener, which
            // this entry does not have.
            .{ .address = "127.0.0.1", .port = 19544, .quic = true, .tcp = false },
            .{ .address = "127.0.0.1", .port = 19444, .tls = true },
        },
        .tls = .{ .cert = "CERTS/server.crt", .key = "CERTS/server.key" },
        .locations = .{
            .{ .prefix = "/", .root = "WWW" },
            .{ .prefix = "/ping", .@"return" = .{ .body = "pong", .content_type = "text/plain" } },
            .{ .prefix = "/up/", .proxy_pass = "be" },
        },
    }},
    .upstreams = .{.{ .name = "be", .servers = .{"127.0.0.1:19090"}, .keepalive = 64 }},
}
